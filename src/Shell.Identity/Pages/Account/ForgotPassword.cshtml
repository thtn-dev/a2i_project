@page "/account/forgot-password"
@model Shell.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
@if (Model.Sent)
{
    <p>If an account exists for this email, a link to set a new password has been sent.</p>
}
else
{
    <form method="post">
        <label>Email <input asp-for="Email" type="email" autocomplete="username" required /></label>
        <button type="submit">Send link</button>
    </form>
}
