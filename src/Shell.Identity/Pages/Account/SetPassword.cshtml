@page "/account/set-password"
@model Shell.Identity.Pages.Account.SetPasswordModel
@{
    ViewData["Title"] = "Set a password";
}
@foreach (var error in Model.Errors)
{
    <p class="error">@error</p>
}
<form method="post">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Token" />
    <label>New password <input asp-for="Password" type="password" autocomplete="new-password" required /></label>
    <button type="submit">Save</button>
</form>
