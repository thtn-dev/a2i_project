{
  "ConnectionStrings": {
    "Catalog": "",
    "DefaultShared": ""
  },
  "Tenancy": {
    "AllowHostHeaderOverride": false,
    "CacheMinutes": 10,
    "NotFoundCacheSeconds": 60,
    "SeedDemoTenants": false
  },
  "Shell": {
    "ShutdownTimeoutSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
