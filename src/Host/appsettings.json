{
  "ConnectionStrings": {
    "Catalog": "",
    "DefaultShared": ""
  },
  "Tenancy": {
    "AllowHostHeaderOverride": false,
    "CacheMinutes": 10,
    "NotFoundCacheSeconds": 60,
    "SeedDemoTenants": false
  },
  "Identity": {
    "Issuer": "",
    "RequireHttps": true,
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 14,
    "MembershipCacheSeconds": 30,
    "Clients": {
      "RedirectUris": [ "https://{domain}/signin-callback" ],
      "PostLogoutRedirectUris": [ "https://{domain}/" ]
    },
    "Keys": {
      "Path": "keys",
      "AutoGenerate": false
    }
  },
  "Shell": {
    "ShutdownTimeoutSeconds": 30,
    "TrustForwardedHeaders": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "OpenIddict": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
